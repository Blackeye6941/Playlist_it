    {
      "parameters": {
        "jsCode": "// Your input data\nconst items = $input.all();\n\n// Count occurrences of each Spotify URL\nconst urlCounts = {};\nconst urlMap = {}; // Store first occurrence of each URL\n\nitems.forEach(item => {\n  const spotifyUrl = item.json.spotify;\n  urlCounts[spotifyUrl] = (urlCounts[spotifyUrl] || 0) + 1;\n  \n  // Store the first occurrence\n  if (!urlMap[spotifyUrl]) {\n    urlMap[spotifyUrl] = item.json;\n  }\n});\n\n// Get unique items that appear more than once\nconst uniqueDuplicates = Object.entries(urlCounts)\n  .filter(([url, count]) => count > 2)\n  .map(([url, count]) => ({\n    ...urlMap[url], // Include all original fields\n    occurrences: count\n  }));\n\nreturn uniqueDuplicates;"
      },
